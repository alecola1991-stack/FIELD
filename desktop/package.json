{
  "name": "futbol-arcade-desktop",
  "version": "1.1.0",
  "description": "Fútbol arcade para Windows",
  "author": "Fútbol arcade",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "package:win": "node create-icon.cjs && electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.futbolarcade.desktop",
    "productName": "Futbol Arcade",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "game/**/*",
      "package.json",
      "icon.png"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.png",
      "signAndEditExecutable": true
    },
    "nsis": {
      "artifactName": "Futbol-Arcade-Setup-${version}.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Fútbol arcade"
    },
    "portable": {
      "artifactName": "Futbol-Arcade-Portable-${version}.exe"
    }
  }
}

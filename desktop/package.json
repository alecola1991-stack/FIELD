{
  "name": "futbol-arcade-desktop",
  "version": "1.3.0",
  "description": "Fútbol arcade para Windows",
  "author": "alecola",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "node create-update.cjs && electron .",
    "package:win": "node create-update.cjs && node create-icon.cjs && electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.9.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.futbolarcade.desktop",
    "productName": "Futbol Arcade",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "game/**/*",
      "package.json",
      "icon.png",
      "updates.cjs",
      "oauth.cjs",
      "preload.cjs",
      "build-info.json",
      "startup.html"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "icon.png",
      "signAndEditExecutable": true,
      "signtoolOptions": {
        "publisherName": [
          "alecola"
        ],
        "signingHashAlgorithms": [
          "sha256"
        ],
        "rfc3161TimeStampServer": "http://timestamp.digicert.com"
      }
    },
    "portable": {
      "artifactName": "Futbol-Arcade-Portable-${version}.exe"
    },
    "copyright": "Copyright © 2026 alecola",
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Fútbol arcade",
      "uninstallDisplayName": "Fútbol arcade",
      "artifactName": "Futbol-Arcade-Setup-${version}.exe",
      "deleteAppDataOnUninstall": false
    }
  }
}
